option_settings:
  # Gunicorn carga el objeto "application" del archivo application.py
  aws:elasticbeanstalk:container:python:
    WSGIPath: application:application
    NumProcesses: 1
    NumThreads: 15
  aws:elasticbeanstalk:application:environment:
    PYTHONUNBUFFERED: "1"
    # AUTH_TOKEN no se define aquí para no empaquetar el secreto en el zip.
    # Configúralo en la consola (Environment properties) o con: eb setenv AUTH_TOKEN=<valor>
