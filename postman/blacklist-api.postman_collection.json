{
  "info": {
    "_postman_id": "7d6c1f4e-2b8a-4f3e-9c1d-5a6b7c8d9e0f",
    "name": "Blacklist API",
    "description": "Pruebas de la API REST de lista negra de emails desplegada en Elastic Beanstalk.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      },
      "response": []
    },
    {
      "name": "Agregar email a la lista negra",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 (o 409 si ya existia)', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
              "pm.test('Trae mensaje', function () { pm.expect(pm.response.json()).to.have.property('msg'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"app_uuid\": \"{{app_uuid}}\",\n  \"blocked_reason\": \"Fraude detectado en la cuenta\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": ["{{base_url}}"],
          "path": ["blacklists"]
        }
      },
      "response": []
    },
    {
      "name": "Consultar email en la lista negra",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Esta en la lista negra', function () { pm.expect(pm.response.json().is_blacklisted).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{email}}",
          "host": ["{{base_url}}"],
          "path": ["blacklists", "{{email}}"]
        }
      },
      "response": []
    },
    {
      "name": "Consultar email que no esta en la lista",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No esta en la lista negra', function () { pm.expect(pm.response.json().is_blacklisted).to.be.false; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/noexiste@ejemplo.com",
          "host": ["{{base_url}}"],
          "path": ["blacklists", "noexiste@ejemplo.com"]
        }
      },
      "response": []
    },
    {
      "name": "Agregar con datos invalidos (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"no-es-un-email\",\n  \"app_uuid\": \"123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": ["{{base_url}}"],
          "path": ["blacklists"]
        }
      },
      "response": []
    },
    {
      "name": "Consultar sin token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{email}}",
          "host": ["{{base_url}}"],
          "path": ["blacklists", "{{email}}"]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://blacklist-api-env.eba-tp3myqmp.us-east-2.elasticbeanstalk.com", "type": "string" },
    { "key": "token", "value": "NIx29FEZsTT0s3fEE", "type": "string" },
    { "key": "email", "value": "usuario@ejemplo.com", "type": "string" },
    { "key": "app_uuid", "value": "6f1c2a8e-3b7d-4c55-9a0e-1f2b3c4d5e6f", "type": "string" }
  ]
}
